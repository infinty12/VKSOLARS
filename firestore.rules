rules_version = '2';

// VK Solar: browsers never talk to Firestore directly. All reads and writes go through the
// website's server, which uses the Admin SDK (that bypasses these rules) and performs its own
// authentication, role checks, CSRF protection, validation and audit logging.
//
// So every client request is denied: a leaked web API key cannot read or change any data,
// customers cannot read each other's records or grant themselves roles.
//
// NOT deployed automatically. Deploy only with explicit approval:
//   npx firebase deploy --only firestore:rules --project <alias>
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
