# Firebase: Admin credentials must never be in the project (keep them OUTSIDE this folder);
# these patterns are a safety net. Also CLI caches and logs.
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*credentials*.json
.firebase/
# Vercel build output and local project link
.vercel/
vercel.env
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

