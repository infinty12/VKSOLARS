---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { enquiryGates } from '../lib/server/settings.ts';
import { listRegions, type Region } from '../lib/server/areas.ts';
import { issueFormToken, ENQUIRY_MESSAGES, REFERENCE_RE, type EnquiryMessageCode } from '../lib/server/enquiries.ts';

// Server-rendered: whether submissions are open, the state list and a fresh signed form token.
// If the database is unavailable the form stays closed (and says so) rather than losing enquiries.
let formOpen = false;
let regions: Region[] = [];
try {
  formOpen = enquiryGates().open;
  regions = listRegions();
} catch (err) {
  console.error('[contact] could not load form settings:', (err as Error).name);
}
const formToken = issueFormToken();
Astro.response.headers.set('Cache-Control', 'no-store'); // the page embeds a per-visit token

// Result of a no-JavaScript submission (whitelisted codes only; never reflected user text).
const outcome = Astro.url.searchParams.get('enquiry');
const ref = Astro.url.searchParams.get('ref') ?? '';
const formResult =
  outcome === 'sent' && REFERENCE_RE.test(ref)
    ? { kind: 'success' as const, message: `Thank you — your enquiry has been received (reference ${ref}). Our team will contact you to arrange your inspection.` }
    : outcome && outcome in ENQUIRY_MESSAGES
      ? { kind: 'error' as const, message: ENQUIRY_MESSAGES[outcome as EnquiryMessageCode] }
      : null;

const nextSteps = [
  { title: 'We review your enquiry', text: 'Your details go straight to our team.' },
  { title: 'We call to arrange a visit', text: 'We confirm your site, access and a convenient time.' },
  { title: 'Inspection and findings', text: 'We inspect your system and explain what we find.' },
];
---

<SiteLayout
  title="Contact Us"
  description="Contact VK Solar to request a free solar inspection or a quote for panel cleaning, maintenance or AI drone inspection, and to check availability for your location in India."
>
  <PageHero eyebrow="Contact" title="Request a free inspection">
    <p>
      Tell us about your solar plant or site and we’ll arrange an inspection. Whether you need cleaning, maintenance, a drone
      survey or help with a fault, this is the place to start.
    </p>
  </PageHero>

  <section id="enquiry" class="section" aria-labelledby="enquiry-title">
    <div class="container contact-layout">
      <div class="contact-form-card">
        <h2 id="enquiry-title" class="contact-form-card__title">Send an enquiry</h2>
        <p class="contact-form-card__intro">It takes about a minute. There’s no obligation.</p>
        <ContactForm open={formOpen && regions.length > 0} token={formToken} regions={regions} result={formResult} />
      </div>

      <aside class="contact-aside" aria-label="Contact information">
        <ContactDetails />

        <div class="aside-card aside-card--light">
          <h2 class="aside-card__title">What happens next</h2>
          <ol role="list" class="next-steps">
            {
              nextSteps.map((s, i) => (
                <li>
                  <span class="next-steps__num mono" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span>
                    <strong>{s.title}</strong>
                    <span class="next-steps__text">{s.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="area-title">
    <div class="container area-layout">
      <div>
        <SectionHeading eyebrow="Service areas" title="Check coverage for your location" id="area-title">
          <p>
            Availability depends on your site’s location, size and the service you need, so we confirm it for every enquiry. See
            the locations we currently serve, or include your location in the form above.
          </p>
        </SectionHeading>
        <div class="area-actions">
          <Button href="/service-areas" variant="secondary" icon="arrowRight">View service areas</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm" aria-labelledby="explore-title">
    <div class="container explore">
      <h2 id="explore-title" class="explore__title">Want to learn more first?</h2>
      <div class="explore__links">
        <Button href="/services" variant="secondary">Browse all services</Button>
        <Button href="/ai-drone-inspection" variant="secondary">How drone inspection works</Button>
        <Button href="/about" variant="secondary">About VK Solar</Button>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .contact-form-card {
    padding: clamp(var(--space-3), 4vw, var(--space-6));
    background: var(--white);
    border: var(--border-thin);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .contact-form-card__title {
    font-size: var(--fs-h3);
  }

  .contact-form-card__intro {
    margin-block: var(--space-1) var(--space-3);
    color: var(--text-secondary);
  }

  .contact-aside {
    display: grid;
    gap: var(--space-3);
  }

  .aside-card {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--gradient-dark);
    color: var(--text-on-dark);
  }

  .aside-card--light {
    background: var(--white);
    color: var(--text-primary);
    border: var(--border-thin);
  }

  .aside-card__title {
    font-size: var(--fs-h4);
    margin-bottom: var(--space-2);
  }

  .next-steps {
    display: grid;
    gap: var(--space-2);
  }

  .next-steps li {
    display: flex;
    gap: var(--space-1-5);
    align-items: flex-start;
  }

  .next-steps li > span:last-child {
    display: grid;
  }

  .next-steps__num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sky-50);
    border: 1.5px solid var(--color-border-strong);
    color: var(--blue-700);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .next-steps__text {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }

  .area-layout {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .explore {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .explore__title {
    font-size: var(--fs-h3);
  }

  .explore__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
  }

  @media (min-width: 1025px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
      gap: var(--space-6);
    }

    .contact-aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-3));
    }

    .area-layout {
      max-width: 880px;
    }
  }
</style>
