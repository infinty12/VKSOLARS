---
// Enquiry form → POST /api/enquiries (stored in the local database, shown in the admin inbox).
// Works without JavaScript (normal form post + redirect); the script adds inline validation,
// in-page status and a duplicate-submission guard.
import Icon from './Icon.astro';
import { businessOf, phoneLabel, telLink, whatsappLink } from '../config/site';
import { services } from '../data/services';
import { LIMITS, CONSENT_TEXT, HONEYPOT_FIELD } from '../lib/enquiry';

interface Props {
  /** Whether submissions are accepted (both the server switch and the admin setting are on). */
  open: boolean;
  /** Signed form token issued by the server for this page view. */
  token: string;
  regions: { code: string; name: string; type: 'state' | 'ut' }[];
  /** Result of a no-JS submission, from the redirect's query string. */
  result?: { kind: 'success' | 'error'; message: string } | null;
}

const { open, token, regions, result = null } = Astro.props;
const business = businessOf(Astro.locals);
const tel = telLink(business);
const wa = whatsappLink(undefined, business);
const serviceOptions = [...services.map((s) => ({ value: s.slug, label: s.title })), { value: 'not-sure', label: 'Not sure — please recommend' }];
const states = regions.filter((r) => r.type === 'state');
const uts = regions.filter((r) => r.type === 'ut');
const fallback = tel
  ? `Please call us on ${phoneLabel(business)}`
  : wa
    ? 'Please message us on WhatsApp'
    : business.contact.email
      ? `Please email ${business.contact.email}`
      : null;
---

<form
  class="enquiry"
  action="/api/enquiries"
  method="post"
  novalidate
  data-enquiry
  data-configured={open ? 'true' : 'false'}
  data-services={JSON.stringify(serviceOptions.map((o) => o.value))}
  data-regions={JSON.stringify(regions.map((r) => r.code))}
  data-fallback={fallback ?? ''}
  aria-describedby="enquiry-required-note"
>
  <input type="hidden" name="_t" value={token} />

  <!-- Spam trap: hidden from people (and from assistive technology), often filled in by bots. -->
  <div class="enquiry__trap" aria-hidden="true">
    <label>Company website (leave empty) <input type="text" name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" /></label>
  </div>

  {
    !open && (
      <div class="enquiry__unconfigured" role="note" data-unconfigured>
        <Icon name="info" size={20} />
        <p>
          <strong>Online enquiries are not active yet.</strong> This form cannot send messages at the moment.
          {fallback ? ` ${fallback}.` : ' Please check back soon.'}
        </p>
      </div>
    )
  }

  <div class="enquiry__summary" data-error-summary tabindex="-1" hidden>
    <h3><Icon name="alert" size={20} /> Please fix the following</h3>
    <ul role="list" data-error-list></ul>
  </div>

  <p id="enquiry-required-note" class="enquiry__note">Fields marked <span aria-hidden="true">*</span><span class="sr-only">required</span> are required.</p>

  <div class="enquiry__grid">
    <div class="field">
      <label for="f-name">Full name <span class="field__req" aria-hidden="true">*</span></label>
      <input id="f-name" name="name" type="text" autocomplete="name" required minlength={LIMITS.nameMin} maxlength={LIMITS.nameMax} aria-describedby="f-name-error" />
      <p class="field__error" id="f-name-error" data-error-for="name"></p>
    </div>

    <div class="field">
      <label for="f-phone">Phone number <span class="field__req" aria-hidden="true">*</span></label>
      <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength={LIMITS.phoneMax} aria-describedby="f-phone-hint f-phone-error" />
      <p class="field__hint" id="f-phone-hint">Mobile or landline, e.g. 98765 43210</p>
      <p class="field__error" id="f-phone-error" data-error-for="phone"></p>
    </div>

    <div class="field">
      <label for="f-email">Email address <span class="field__optional">(optional)</span></label>
      <input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength={LIMITS.emailMax} aria-describedby="f-email-error" />
      <p class="field__error" id="f-email-error" data-error-for="email"></p>
    </div>

    <div class="field">
      <label for="f-service">Service required <span class="field__req" aria-hidden="true">*</span></label>
      <div class="field__select">
        <select id="f-service" name="service" required aria-describedby="f-service-error">
          <option value="">Select a service</option>
          {serviceOptions.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
        <Icon name="chevronRight" size={18} class="field__chevron" />
      </div>
      <p class="field__error" id="f-service-error" data-error-for="service"></p>
    </div>

    <div class="field">
      <label for="f-region">State or union territory <span class="field__req" aria-hidden="true">*</span></label>
      <div class="field__select">
        <select id="f-region" name="region" required autocomplete="address-level1" aria-describedby="f-region-error">
          <option value="">Select…</option>
          <optgroup label="States">{states.map((r) => <option value={r.code}>{r.name}</option>)}</optgroup>
          <optgroup label="Union territories">{uts.map((r) => <option value={r.code}>{r.name}</option>)}</optgroup>
        </select>
        <Icon name="chevronRight" size={18} class="field__chevron" />
      </div>
      <p class="field__error" id="f-region-error" data-error-for="region"></p>
    </div>

    <div class="field">
      <label for="f-location">Site location <span class="field__req" aria-hidden="true">*</span></label>
      <input id="f-location" name="location" type="text" autocomplete="address-level2" required maxlength={LIMITS.locationMax} aria-describedby="f-location-hint f-location-error" />
      <p class="field__hint" id="f-location-hint">City, town or industrial area</p>
      <p class="field__error" id="f-location-error" data-error-for="location"></p>
    </div>

    <div class="field field--full">
      <label for="f-message">Message <span class="field__optional">(optional)</span></label>
      <textarea id="f-message" name="message" rows="5" maxlength={LIMITS.messageMax} aria-describedby="f-message-hint f-message-error"></textarea>
      <p class="field__hint" id="f-message-hint">
        Tell us about your system size, rooftop or ground-mount, and any issues you’ve noticed.
        <span class="field__count mono" data-count aria-live="polite">0 / {LIMITS.messageMax}</span>
      </p>
      <p class="field__error" id="f-message-error" data-error-for="message"></p>
    </div>

    <div class="field field--full">
      <label class="field__consent">
        <input type="checkbox" name="consent" value="on" required aria-describedby="f-consent-error" />
        <span>{CONSENT_TEXT} <span class="field__req" aria-hidden="true">*</span></span>
      </label>
      <p class="field__error" id="f-consent-error" data-error-for="consent"></p>
    </div>
  </div>

  <div class="enquiry__footer">
    <button type="submit" class="enquiry__submit" data-submit>
      <span class="enquiry__spinner" aria-hidden="true"></span>
      <span data-submit-label>Request free inspection</span>
      <Icon name="arrowRight" size={20} />
    </button>
    <p class="enquiry__privacy">We use your details only to respond to this enquiry.</p>
  </div>

  <div
    class:list={['enquiry__status', result && `enquiry__status--${result.kind}`]}
    data-status
    role="status"
    aria-live="polite"
    tabindex="-1"
  >
    {result && <strong>{result.message}</strong>}
  </div>
</form>

<script>
  import { validateEnquiry, normaliseEnquiry, HONEYPOT_FIELD, type EnquiryValues, type EnquiryErrors } from '../lib/enquiry';

  const TIMEOUT_MS = 15000;
  const FIELDS = ['name', 'phone', 'email', 'service', 'region', 'location', 'message', 'consent'] as const;

  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const serviceSlugs: string[] = JSON.parse(form.dataset.services ?? '[]');
    const regionCodes: string[] = JSON.parse(form.dataset.regions ?? '[]');
    const fallback = form.dataset.fallback ?? '';
    const summary = form.querySelector<HTMLElement>('[data-error-summary]')!;
    const summaryList = form.querySelector<HTMLElement>('[data-error-list]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const message = form.querySelector<HTMLTextAreaElement>('[name="message"]')!;
    const counter = form.querySelector<HTMLElement>('[data-count]');
    const touched = new Set<string>();
    const opts = { serviceSlugs, regionCodes };
    let submitting = false;

    const control = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`)!;
    const consentBox = control('consent') as HTMLInputElement;

    // Pre-fill from the URL, e.g. /contact?service=ac-service&location=Jaipur
    const params = new URLSearchParams(window.location.search);
    const preService = params.get('service');
    const preLocation = params.get('location');
    if (preService && serviceSlugs.includes(preService)) control('service').value = preService;
    if (preLocation) control('location').value = preLocation.slice(0, 120);

    const rawValues = (): EnquiryValues => ({
      name: control('name').value,
      phone: control('phone').value,
      email: control('email').value,
      service: control('service').value,
      region: control('region').value,
      location: control('location').value,
      message: control('message').value,
      consent: consentBox.checked,
    });

    const showFieldError = (name: string, text?: string) => {
      const el = control(name);
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
      slot.textContent = text ?? '';
      if (text) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    };

    const renderErrors = (errors: EnquiryErrors, only?: string) => {
      FIELDS.forEach((f) => {
        if (!only || f === only) showFieldError(f, errors[f]);
      });
    };

    const setStatus = (kind: 'success' | 'error' | 'info' | '', text: string) => {
      status.className = `enquiry__status${kind ? ` enquiry__status--${kind}` : ''}`;
      status.replaceChildren();
      if (text) {
        const strong = document.createElement('strong');
        strong.textContent = text; // textContent only — never inject markup
        status.append(strong);
      }
    };

    const showSummary = (errors: EnquiryErrors) => {
      const entries = Object.entries(errors) as [string, string][];
      summaryList.replaceChildren(
        ...entries.map(([f, msg]) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${control(f).id}`;
          a.textContent = msg;
          li.append(a);
          return li;
        }),
      );
      summary.hidden = entries.length === 0;
      if (entries.length) summary.focus();
    };

    FIELDS.forEach((f) => {
      const el = control(f);
      el.addEventListener('blur', () => {
        if (f !== 'consent' && !el.value && f !== 'service' && f !== 'region') return;
        touched.add(f);
        renderErrors(validateEnquiry(normaliseEnquiry(rawValues()), opts), f);
      });
      const live = () => {
        if (touched.has(f)) renderErrors(validateEnquiry(normaliseEnquiry(rawValues()), opts), f);
      };
      el.addEventListener('input', live);
      el.addEventListener('change', live);
    });

    const updateCount = () => {
      if (counter) counter.textContent = `${message.value.length} / ${message.maxLength}`;
    };
    message.addEventListener('input', updateCount);
    updateCount();

    const setBusy = (busy: boolean) => {
      submitting = busy;
      submit.disabled = busy;
      form.setAttribute('aria-busy', String(busy));
      submit.classList.toggle('is-loading', busy);
      submitLabel.textContent = busy ? 'Sending…' : 'Request free inspection';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return; // prevent duplicate submissions

      const values = normaliseEnquiry(rawValues());
      const errors = validateEnquiry(values, opts);
      FIELDS.forEach((f) => touched.add(f));
      renderErrors(errors);
      if (Object.keys(errors).length) {
        setStatus('', '');
        showSummary(errors);
        return;
      }
      summary.hidden = true;

      if (form.dataset.configured !== 'true') {
        setStatus('error', `Online enquiries are not active yet, so your message was not sent.${fallback ? ` ${fallback} instead.` : ''}`);
        status.focus();
        return;
      }

      setBusy(true);
      setStatus('info', 'Sending your enquiry…');
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...values,
            _t: control('_t').value,
            [HONEYPOT_FIELD]: control(HONEYPOT_FIELD).value,
          }),
          signal: controller.signal,
        });
        const result = (await response.json().catch(() => null)) as
          | { ok: boolean; reference?: string; message?: string; errors?: EnquiryErrors }
          | null;

        if (response.status === 201 && result?.ok) {
          form.reset();
          touched.clear();
          updateCount();
          renderErrors({});
          setStatus('success', `Thank you — your enquiry has been received (reference ${result.reference}). Our team will contact you to arrange your inspection.`);
        } else if (response.status === 422 && result?.errors) {
          renderErrors(result.errors);
          showSummary(result.errors);
          setStatus('error', result.message ?? 'Please correct the highlighted fields.');
        } else {
          setStatus('error', `${result?.message ?? 'Sorry, your enquiry could not be sent.'} Your details are still in the form.`);
        }
      } catch (error) {
        const aborted = error instanceof DOMException && error.name === 'AbortError';
        setStatus(
          'error',
          `${aborted ? 'The request timed out' : 'Sorry, your enquiry could not be sent'}. Your details are still in the form — please try again${
            fallback ? `, or ${fallback.charAt(0).toLowerCase() + fallback.slice(1)}` : ''
          }.`,
        );
      } finally {
        window.clearTimeout(timer);
        setBusy(false);
        status.focus();
      }
    });
  });
</script>

<style>
  .enquiry {
    display: grid;
    gap: var(--space-3);
  }

  .enquiry__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .enquiry__unconfigured {
    display: flex;
    gap: var(--space-1-5);
    align-items: flex-start;
    padding: var(--space-2);
    border: 1.5px solid var(--color-warning-border);
    border-radius: var(--radius-md);
    background: var(--color-warning-bg);
    color: var(--color-warning);
    font-size: var(--fs-sm);
  }

  .enquiry__unconfigured :global(.icon) {
    margin-top: 2px;
  }

  .enquiry__note {
    color: var(--text-supporting);
    font-size: var(--fs-sm);
  }

  .enquiry__grid {
    display: grid;
    gap: var(--space-3) var(--space-2);
  }

  @media (min-width: 641px) {
    .enquiry__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field--full {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .field label {
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    color: var(--text-primary);
  }

  .field__req {
    color: var(--color-error);
  }

  .field__optional {
    font-weight: var(--fw-regular);
    color: var(--text-supporting);
  }

  .field input:not([type='checkbox']),
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.875rem;
    border: 1.5px solid var(--color-border-control);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--text-primary);
    font-size: var(--fs-base); /* ≥16px prevents iOS zoom on focus */
    transition:
      border-color var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }

  .field textarea {
    resize: vertical;
    min-height: 132px;
  }

  .field input:not([type='checkbox']):hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--brand-solar);
  }

  .field input:not([type='checkbox']):focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--brand-solar);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-steel) 35%, transparent);
  }

  .field [aria-invalid='true'] {
    border-color: var(--color-error);
    background: var(--color-error-bg);
  }

  .field [aria-invalid='true']:focus-visible {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-error) 20%, transparent);
  }

  .field__select {
    position: relative;
  }

  .field__select select {
    appearance: none;
    padding-right: 2.5rem;
  }

  .field__select :global(.field__chevron) {
    position: absolute;
    right: 0.875rem;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    color: var(--text-supporting);
    pointer-events: none;
  }

  .field__consent {
    display: flex;
    gap: var(--space-1-5);
    align-items: flex-start;
    font-weight: var(--fw-regular) !important;
    line-height: 1.5;
    cursor: pointer;
  }

  .field__consent input {
    flex-shrink: 0;
    width: 24px; /* WCAG 2.2 minimum target size */
    height: 24px;
    margin-top: 1px;
    accent-color: var(--brand-solar);
  }

  .field__consent:has([aria-invalid='true']) input {
    outline: 2px solid var(--color-error);
    outline-offset: 2px;
  }

  .field__hint {
    display: flex;
    justify-content: space-between;
    gap: var(--space-1);
    color: var(--text-supporting);
    font-size: var(--fs-xs);
  }

  .field__count {
    flex-shrink: 0;
  }

  .field__error {
    color: var(--color-error);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }

  .field__error:empty {
    display: none;
  }

  .enquiry__summary {
    padding: var(--space-2) var(--space-3);
    border: 1.5px solid var(--color-error);
    border-radius: var(--radius-md);
    background: var(--color-error-bg);
  }

  .enquiry__summary h3 {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-error);
    font-size: var(--fs-base);
    margin-bottom: var(--space-1);
  }

  .enquiry__summary ul {
    display: grid;
    gap: 2px;
    padding-left: var(--space-4);
    list-style: disc;
  }

  .enquiry__summary a {
    color: var(--color-error);
    font-size: var(--fs-sm);
  }

  .enquiry__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .enquiry__submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: 52px;
    padding-inline: var(--space-4);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--gradient-cta);
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--dur-base) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }

  .enquiry__submit:hover {
    box-shadow: var(--shadow-md);
    background: var(--btn-primary-bg-hover);
  }

  .enquiry__submit:active {
    transform: translateY(1px);
  }

  .enquiry__submit:disabled {
    cursor: progress;
    opacity: 0.8;
  }

  .enquiry__spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid color-mix(in srgb, var(--white) 35%, transparent);
    border-top-color: var(--white);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .enquiry__submit:global(.is-loading) .enquiry__spinner {
    display: inline-block;
  }

  .enquiry__submit:global(.is-loading) :global(.icon) {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .enquiry__privacy {
    color: var(--text-supporting);
    font-size: var(--fs-xs);
  }

  .enquiry__status:empty {
    display: none;
  }

  .enquiry__status {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 1.5px solid transparent;
    font-size: var(--fs-sm);
  }

  .enquiry__status:global(.enquiry__status--success) {
    background: var(--color-success-bg);
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .enquiry__status:global(.enquiry__status--error) {
    background: var(--color-error-bg);
    border-color: var(--color-error);
    color: var(--color-error);
  }

  .enquiry__status:global(.enquiry__status--info) {
    background: var(--ice-100);
    border-color: var(--brand-steel);
    color: var(--brand-solar);
  }
</style>
