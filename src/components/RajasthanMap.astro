---
// Simplified outline of Rajasthan (approximate, not to scale for navigation).
// Pins are drawn ONLY for cities listed as confirmed in site.serviceAreas.confirmed.
import { site } from '../config/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

// Approximate boundary, [lat, lon], clockwise from the northern tip.
const outline: [number, number][] = [
  [30.18, 73.9], [29.9, 74.6], [29.4, 75.2], [28.9, 75.6], [28.4, 76.0], [28.0, 76.4], [28.2, 76.9],
  [27.8, 77.2], [27.4, 77.5], [27.0, 77.6], [26.9, 77.9], [26.6, 77.8], [26.3, 77.2], [25.9, 77.0],
  [25.4, 77.2], [25.0, 76.9], [24.4, 76.6], [23.9, 76.2], [24.2, 75.8], [24.4, 75.2], [23.7, 74.9],
  [23.1, 74.5], [23.3, 73.9], [23.8, 73.4], [24.3, 73.0], [24.4, 72.4], [24.6, 71.6], [24.6, 71.0],
  [25.0, 70.6], [25.7, 70.1], [26.5, 70.0], [27.0, 69.6], [27.6, 70.4], [28.0, 70.8], [28.4, 71.9],
  [29.0, 72.5], [29.6, 73.2], [30.1, 73.4],
];

const LON0 = 69.2;
const LAT0 = 30.5;
const SCALE = 56;
const X_FACTOR = 0.9; // cos(~26°N) keeps proportions roughly right
const project = (lat: number, lon: number) => ({ x: (lon - LON0) * SCALE * X_FACTOR + 10, y: (LAT0 - lat) * SCALE + 10 });

const path =
  outline
    .map(([lat, lon], i) => {
      const { x, y } = project(lat, lon);
      return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .join(' ') + 'Z';

const width = Math.ceil((78.3 - LON0) * SCALE * X_FACTOR + 20);
const height = Math.ceil((LAT0 - 22.9) * SCALE + 20);

const pins = site.serviceAreas.confirmed
  .filter((c) => c.coords)
  .map((c) => ({ name: c.name, ...project(c.coords!.lat, c.coords!.lon) }));

const label = pins.length
  ? `Simplified map of Rajasthan showing confirmed service locations: ${pins.map((p) => p.name).join(', ')}.`
  : 'Simplified outline map of Rajasthan, the state VK Solar serves.';
---

<figure class:list={['rmap', { 'rmap--compact': compact }]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label} class="rmap__svg">
    <defs>
      <pattern id="rmap-grid" width="16" height="16" patternUnits="userSpaceOnUse">
        <path d="M16 0H0V16" class="rmap__grid-line"></path>
      </pattern>
      <linearGradient id="rmap-fill" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" class="rmap__stop-a"></stop>
        <stop offset="1" class="rmap__stop-b"></stop>
      </linearGradient>
    </defs>
    <path d={path} fill="url(#rmap-fill)" class="rmap__outline"></path>
    <path d={path} fill="url(#rmap-grid)"></path>
    {
      pins.map((p) => (
        <g class="rmap__pin">
          <circle cx={p.x} cy={p.y} r="11" class="rmap__pin-halo" />
          <circle cx={p.x} cy={p.y} r="5.5" class="rmap__pin-dot" />
          {!compact && (
            <text x={p.x + 9} y={p.y - 9} class="rmap__label">
              {p.name}
            </text>
          )}
        </g>
      ))
    }
    {
      pins.length === 0 && (
        <text x={width / 2} y={height / 2} text-anchor="middle" class="rmap__state">
          RAJASTHAN
        </text>
      )
    }
  </svg>
  <figcaption class="rmap__caption">
    {
      pins.length ? (
        <>
          <span class="rmap__key" aria-hidden="true" /> Confirmed service location
        </>
      ) : (
        <>Service across Rajasthan — availability is confirmed for each site.</>
      )
    }
    <span class="rmap__disclaimer">Simplified outline, not to scale.</span>
  </figcaption>
</figure>

<style>
  .rmap {
    display: grid;
    gap: var(--space-1-5);
  }

  .rmap__svg {
    width: 100%;
    height: auto;
    max-height: 520px;
  }

  .rmap--compact .rmap__svg {
    max-height: 260px;
  }

  .rmap__grid-line {
    fill: none;
    stroke: var(--brand-soft);
    stroke-opacity: 0.35;
    stroke-width: 0.6;
  }

  .rmap__stop-a {
    stop-color: var(--ice-100);
  }

  .rmap__stop-b {
    stop-color: var(--ice-200);
  }

  .rmap__outline {
    stroke: var(--brand-solar);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .rmap__pin-halo {
    fill: var(--brand-solar);
    fill-opacity: 0.15;
  }

  .rmap__pin-dot {
    fill: var(--brand-solar);
    stroke: var(--white);
    stroke-width: 2;
  }

  .rmap__label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    fill: var(--brand-midnight);
    paint-order: stroke;
    stroke: var(--white);
    stroke-width: 3px;
  }

  /* 22px semibold is not "large text", so it needs 4.5:1 → Deep Solar Blue (12.8:1 on ice-200). */
  .rmap__state {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.3em;
    fill: var(--brand-solar);
  }

  .rmap__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-0-5) var(--space-1);
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }

  .rmap__key {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--blue-700);
    box-shadow: 0 0 0 2px var(--white), 0 0 0 4px color-mix(in srgb, var(--brand-solar) 20%, transparent);
  }

  .rmap__disclaimer {
    color: var(--text-supporting);
    font-size: var(--fs-xs);
  }
</style>
