---
// Illustrative thermal (infrared) view of a single PV module, drawn as SVG.
// Each "variant" shows a typical fault signature. Not a real inspection image.
import { nextId } from '../lib/ids';

export type ThermalVariant = 'hotspot' | 'diode' | 'soiling' | 'cracked' | 'offline' | 'healthy';

interface Props {
  variant: ThermalVariant;
  class?: string;
}

const { variant, class: className } = Astro.props;

const COLS = 6;
const ROWS = 10;

// Deterministic noise so builds are stable.
let seed = [...variant].reduce((s, c) => s + c.charCodeAt(0), 7);
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};

// Temperature 0 (cool) … 1 (hot) per cell.
function temp(c: number, r: number): number {
  const base = 0.28 + rand() * 0.06;
  switch (variant) {
    case 'hotspot':
      if (c === 3 && r === 4) return 0.98;
      if (Math.abs(c - 3) + Math.abs(r - 4) === 1) return 0.5;
      return base;
    case 'diode':
      return c >= 4 ? 0.6 + rand() * 0.05 : base;
    case 'soiling':
      return base + Math.max(0, (r - 6) / 3) * 0.35;
    case 'cracked':
      if ((c === 1 && (r === 6 || r === 7)) || (c === 2 && r === 7)) return 0.78;
      return base;
    case 'offline':
      return 0.58 + rand() * 0.05;
    default:
      return base;
  }
}

// "Iron" palette stops, cool → hot.
const stops: [number, [number, number, number]][] = [
  [0, [20, 16, 72]],
  [0.3, [72, 36, 140]],
  [0.5, [176, 44, 120]],
  [0.68, [232, 90, 30]],
  [0.85, [250, 176, 20]],
  [1, [255, 248, 200]],
];

function colour(t: number) {
  const v = Math.min(1, Math.max(0, t));
  for (let i = 1; i < stops.length; i++) {
    const [p1, c1] = stops[i];
    const [p0, c0] = stops[i - 1];
    if (v <= p1) {
      const k = (v - p0) / (p1 - p0);
      const mix = c0.map((x, j) => Math.round(x + (c1[j] - x) * k));
      return `rgb(${mix.join(' ')})`;
    }
  }
  return 'rgb(255 248 200)';
}

const cell = 20;
const gap = 2;
const pad = 10;
const width = pad * 2 + COLS * cell + (COLS - 1) * gap;
const height = pad * 2 + ROWS * cell + (ROWS - 1) * gap;

const cells = Array.from({ length: COLS * ROWS }, (_, i) => {
  const c = i % COLS;
  const r = Math.floor(i / COLS);
  return { x: pad + c * (cell + gap), y: pad + r * (cell + gap), fill: colour(temp(c, r)) };
});
// The same variant can appear twice on a page (thumbnail + lightbox), so filter ids need a per-render suffix.
const uid = `th-${variant}-${nextId()}`;
---

<svg
  class:list={['thermal', className]}
  viewBox={`0 0 ${width} ${height}`}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <filter id={`${uid}-blur`} x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="2.2"></feGaussianBlur>
    </filter>
  </defs>
  <rect width={width} height={height} rx="6" fill="#0d0b33"></rect>
  <g filter={`url(#${uid}-blur)`}>
    {cells.map((c) => <rect x={c.x} y={c.y} width={cell} height={cell} fill={c.fill} />)}
  </g>
</svg>

<!-- Global (unscoped) so Astro doesn't stamp a scoping attribute onto every cell <rect>. -->
<style is:global>
  .thermal {
    width: 100%;
    height: 100%;
  }
</style>
