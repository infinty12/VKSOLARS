{
  "name": "vk-solar",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Website for VK Solar High-Tech Power Solution — solar cleaning, maintenance and AI drone inspection across Rajasthan.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "preview": "npm run start",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:install": "playwright install chromium",
    "contrast": "node scripts/check-contrast.mjs",
    "tokens": "node scripts/check-tokens.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "links": "node scripts/check-links.mjs",
    "validate:html": "html-validate \".snapshot/**/*.html\"",
    "seo": "node scripts/check-seo.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "verify": "npm run check && npm run lint && npm run contrast && npm run tokens && npm run test:unit && npm run build && npm run snapshot && npm run links && npm run validate:html && npm run seo && npm run smoke:admin && npm run test",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "backup:list": "node --env-file-if-exists=.env scripts/backup-list.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "firebase:check": "node --env-file-if-exists=.env scripts/firebase-check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.4.0",
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "firebase-tools": "^15.34.0",
    "html-validate": "^11.16.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
