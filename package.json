{
  "name": "vk-solar",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Website for VK Solar High-Tech Power Solution — solar cleaning, maintenance and AI drone inspection across Rajasthan.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "contrast": "node scripts/check-contrast.mjs",
    "tokens": "node scripts/check-tokens.mjs",
    "links": "node scripts/check-links.mjs",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "seo": "node scripts/check-seo.mjs dist",
    "verify": "npm run check && npm run lint && npm run contrast && npm run tokens && npm run build && npm run links && npm run validate:html && npm run seo && npm run test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.16.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
