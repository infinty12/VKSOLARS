# Copy to .env and fill in. Never commit .env.

# Live domain, no trailing slash. Enables canonical URLs, og:url and sitemap.xml.
PUBLIC_SITE_URL=

# Web3Forms access key (free: https://web3forms.com). This key is designed to be public
# and is safe in frontend code. Until it is set, the contact form reports
# "not configured" and never pretends a message was sent.
PUBLIC_WEB3FORMS_KEY=
