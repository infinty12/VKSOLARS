# Copy to .env and fill in. Never commit .env.  (`npm start`, `npm run db:migrate` and
# `npm run admin:create` load it automatically.)

# Live domain, no trailing slash. Enables canonical URLs, og:url and sitemap.xml.
# Must be set at BUILD time (npm run build).
PUBLIC_SITE_URL=

# Where the SQLite database, secret key and uploads live. Default: ./storage (excluded from Git).
STORAGE_DIR=

# Where backups are saved (npm run backup, Admin -> Backups). Default: ./backups (excluded from Git).
# Backups contain customer enquiries: keep this folder private.
BACKUP_DIR=

# Server switch for public enquiries. Submissions are accepted only when this is "true" AND the
# admin setting "Accept enquiries" (Admin → Enquiries → Settings) is on. Leave unset to keep the
# contact form closed.
ENQUIRIES_ENABLED=

# ---- Email notifications for new enquiries (OFF unless MAIL_ENABLED=true) ----------------
# Enquiries are always stored first; email is sent afterwards and retried on failure, so a
# mail problem never loses an enquiry. Invalid settings disable sending (shown in the admin).
MAIL_ENABLED=
# smtp (real email) — "mock" is for automated tests only and is refused outside test storage.
MAIL_TRANSPORT=smtp
# Recipient(s), comma-separated (max 5). The intended inbox is vksolar.contact@gmail.com —
# confirm it is the right, working mailbox before setting it here.
MAIL_TO=
# Sender address. For Gmail SMTP this must be the Gmail account itself.
MAIL_FROM=
# SMTP server. Gmail: smtp.gmail.com, port 587 (STARTTLS) or 465 with SMTP_SECURE=true,
# SMTP_USER = the Gmail address, SMTP_PASS = a Google "App password" (requires 2-Step
# Verification) — never the normal account password. Keep these only in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# true = include the customer's name, phone, email, location and message in the email.
# Default (empty) = reference, service, state and an admin link only.
MAIL_INCLUDE_DETAILS=
# Base URL used for the "open in admin" link in emails. Default http://127.0.0.1:PORT
ADMIN_BASE_URL=

# ---- Firebase (OFF unless FIREBASE_ENABLED=true; the website does not depend on it yet) --------
# Web app identifiers from Firebase console -> Project settings -> Your apps (not secrets, but keep
# them here rather than in code). Check them with: npm run firebase:check
FIREBASE_ENABLED=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
# "dev" (default) or "prod". Every collection and storage path is prefixed with this, so test data
# never mixes with real data. Choose "prod" only deliberately.
FIREBASE_DATA_ENV=dev
# Admin credentials - NEVER paste a private key here or anywhere in the project:
#  - local: absolute path to a service-account JSON file kept OUTSIDE this project folder, or
#  - hosted on Google Cloud: leave the path empty and set FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=true.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=
# Customer portal (/register, /login, /dashboard). Needs Firebase ready. Leave off until tested.
CUSTOMER_PORTAL_ENABLED=

# Optional: secret for signing form tokens. If unset, a random key is created in STORAGE_DIR.
APP_SECRET=

# Network binding. Defaults keep everything on this computer only.
HOST=127.0.0.1
PORT=4321

# Leave unset: /admin is only reachable from this computer. Do not enable without HTTPS and a
# reviewed deployment.
ADMIN_ALLOW_REMOTE=

# Set to true only when served over HTTPS behind a proxy that terminates TLS.
COOKIE_SECURE=

# Set to true only behind a reverse proxy you control that sets X-Forwarded-* headers.
TRUST_PROXY=
